# VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_USER_ID=your_user_id
VITE_FEDAPAY_PUBLIC_KEY=your_fedapay_public_key
VITE_GA_ID=G-XXXXXXXXXX

# Tableau de bord (/admin) : à définir dans Netlify, Site configuration > Environment variables.
# Ne jamais écrire les vraies valeurs dans ce fichier.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=          (12 caractères au moins)
# GMAIL_USER=              (adresse Gmail qui envoie les réponses)
# GMAIL_APP_PASSWORD=      (mot de passe d'application Google, pas le mot de passe du compte)
# GEMINI_API_KEY=          (déjà utilisée par l'assistant du site)
